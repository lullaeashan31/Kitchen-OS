APP_NAME="Traverse Inc."
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_NEW_KEY_RUN_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_YOUR_DOMAIN.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DB_NAME
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_YOUR_WHATSAPP_ACCOUNT_ID
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_YOUR_WHATSAPP_TOKEN
